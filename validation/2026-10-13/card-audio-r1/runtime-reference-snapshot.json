  "reservedDetails": [
    {
      "id": "skill.quake",
      "name": "裂地横扫",
      "note": "quake-start启动时；目标横排含特殊／万能块，按列间隔44ms推进。不可等末格清除后的effect才发声。"
    },
    {
      "id": "skill.meteor",
      "name": "陨石坠落",
      "note": "下降与撞击分开；实际清除最早在1600ms的队列结算，忙碌／冻结时顺延。撞击跟实际effect，不仅靠固定倒计时。"
    },
    {
      "id": "skill.bomb",
      "name": "炸弹投放",
      "note": "先投放／轻引信；真正爆破最早1800ms，目标忙碌或冻结时可能推迟，跟真实effect。"
    },
    {
      "id": "skill.storm",
      "name": "混乱风暴",
      "note": "实际card-change改变6个普通块颜色时反馈，空闲棋盘可立即提交；视觉本体不早于光团落地后80ms。"
    },
    {
      "id": "skill.fog",
      "name": "迷雾领域",
      "note": "cast时立即生效6秒；当前代码是落点附近4×4区域、边缘贴边、空洞裁剪。1.2秒视觉消散不延长控制。"
    },
    {
      "id": "skill.overload",
      "name": "超载模式",
      "note": "cast激活10秒得分×2；仅启动一次，状态期间安静。"
    },
    {
      "id": "skill.sage",
      "name": "贤者时间",
      "note": "cast激活5秒，每650ms尝试自动操作；只播激活反馈，后续操作沿用核心音。"
    },
    {
      "id": "skill.rainbow",
      "name": "彩虹核心",
      "note": "实际card-change指定index变成万能块时反馈；目标tile id不符则转换失效，不伪造命中。忙碌时光团可悬停，实际落点确定后继续飞180ms。"
    }
  ]
